# 新装模板：复制到 /etc/douyin-dl.env 后填写；真实文件禁止提交 Git。
ADMIN_PASSWORD=
REQUIRE_ADMIN_PASSWORD=1
PUBLIC_ORIGIN=https://your-domain.com
TRUST_PROXY=1
TRUST_PROXY_HOPS=1
COOKIE_SECURE=1
DATA_DIR=/srv/douyin-dl/data
FREE_ANON_DAILY=3
FREE_USER_DAILY=10
API_JOB_WORKERS=2
ATC_WORKERS=1
# 元数据旁路与主解析并行；专用游客会话下优先 HTTP，失败后网页补充。
# 推荐独立 Python 3.12 运行时；仓库 .venv-metadata 安装后自动发现，其他路径显式指定。
# BROWSER_TITLE_PYTHON=/srv/douyin-dl/.venv-metadata/bin/python
# 代理仅接受显式配置(HTTP/HTTPS/无认证SOCKS5)，不隐式读取系统 HTTP_PROXY。
# 严格代理模式必须配置此项才启动旁路；本机DNS仍须解析为公网地址。
# BROWSER_TITLE_PROXY_URL=http://127.0.0.1:7897
METADATA_HTTP_ENABLED=1
HTTP_BUDGET_SECONDS=1.5
# 设 0 完全关闭；安装时的 PLAYWRIGHT_BROWSERS_PATH 必须与服务运行时一致。
BROWSER_TITLE_ENABLED=1
BROWSER_TITLE_TIMEOUT_SECONDS=6
BROWSER_TITLE_WORKERS=2
BROWSER_TITLE_QUEUE_MAX=8
BROWSER_TITLE_STARTUP_TIMEOUT_SECONDS=12
# PLAYWRIGHT_BROWSERS_PATH=/srv/douyin-dl/browser-cache
# 新安装不设 APP_SECRET，应用在 DATA_DIR/.app-secret 生成并持久保存。
# 已有部署设置过 APP_SECRET 或 CAPTCHA_SECRET：必须在真实配置中保留原值。
# APP_SECRET=仅填写已有部署正在使用的原值，不能每次启动重新生成
# 不使用机场订阅功能时可开启；已有部署需保留原策略。
# MIHOMO_OFF=1
# 分享域名池可选，逗号分隔；后台主分享域名优先。
# SHARE_DOMAINS=https://share.your-domain.com
