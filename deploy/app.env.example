# 新装模板：复制到 /etc/douyin-dl.env 后填写；真实文件禁止提交 Git。
ADMIN_PASSWORD=
REQUIRE_ADMIN_PASSWORD=1
PUBLIC_ORIGIN=https://your-domain.com
TRUST_PROXY=1
TRUST_PROXY_HOPS=1
COOKIE_SECURE=1
DATA_DIR=/srv/douyin-dl/data
DOUYIN_BROWSER_BIN=/usr/bin/chromium
DOUYIN_BROWSER_ENABLED=auto
FREE_ANON_DAILY=3
FREE_USER_DAILY=10
API_JOB_WORKERS=2
ATC_WORKERS=1
# 新安装不设 APP_SECRET，应用在 DATA_DIR/.app-secret 生成并持久保存。
# 已有部署设置过 APP_SECRET 或 CAPTCHA_SECRET：必须在真实配置中保留原值。
# APP_SECRET=仅填写已有部署正在使用的原值，不能每次启动重新生成
# 不使用机场订阅功能时可开启；已有部署需保留原策略。
# MIHOMO_OFF=1
# 分享域名池可选，逗号分隔；后台主分享域名优先。
# SHARE_DOMAINS=https://share.your-domain.com
